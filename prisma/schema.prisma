generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
  DOCTOR
  PATIENT
}

model User {
  id           String        @id @default(uuid())
  name         String?
  email        String        @unique
  password     String
  role         Role          @default(USER)
  patient      Patient?
  professional Professional?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Patient {
  id             String          @id @default(uuid())
  fullName       String
  cpf            String?         @unique
  phone          String?
  birthDate      String?
  gender         String?
  address        String?
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders         Order[]
  homeCareOrders HomeCareOrder[]
  results        LabResult[]
  professionals  Professional[]  @relation("ProfessionalPatients")
  medicalRecords MedicalRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Professional {
  id                String          @id @default(uuid())
  name              String
  specialty         String
  registration      String?
  phone             String?
  consultationPrice Float           @default(0)
  active            Boolean         @default(true)
  userId            String?         @unique
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  patients          Patient[]       @relation("ProfessionalPatients")
  orders            Order[]
  medicalRecords    MedicalRecord[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model MedicalRecord {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  complaint      String?
  evaluation     String?
  diagnosis      String?
  plan           String?
  createdAt      DateTime     @default(now())
}

model Exam {
  id            String         @id @default(uuid())
  name          String
  code          String?        @unique
  category      String?
  price         Float
  deliveryDays  Int            @default(1)
  description   String?
  orderItems    OrderItem[]
  homeCareItems HomeCareItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Order {
  id              String        @id @default(uuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId  String?
  professional    Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  consultationFee Float         @default(0)
  serviceDate     DateTime?
  totalPrice      Float
  status          String        @default("PENDING")
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  price     Float
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   @default("Operacional")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeCareOrder {
  id             String                  @id @default(uuid())
  patientId      String
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  neighborhood   String
  city           String
  collectionLab  String
  collectionDate DateTime?
  collectionFee  Float                   @default(0)
  travelFee      Float                   @default(0)
  examsTotal     Float                   @default(0)
  totalPrice     Float                   @default(0)
  status         String                  @default("ORCAMENTO")
  items          HomeCareItem[]
  reimbursements HomeCareReimbursement[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model HomeCareItem {
  id              String        @id @default(uuid())
  homeCareOrderId String
  homeCareOrder   HomeCareOrder @relation(fields: [homeCareOrderId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam          @relation(fields: [examId], references: [id])
  price           Float
  createdAt       DateTime      @default(now())
}

model HomeCareReimbursement {
  id              String        @id @default(uuid())
  homeCareOrderId String
  homeCareOrder   HomeCareOrder @relation(fields: [homeCareOrderId], references: [id], onDelete: Cascade)
  description     String
  amount          Float
  status          String        @default("PENDENTE")
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
}

model LabResult {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  fileName  String
  fileSize  Int
  data      Bytes
  createdAt DateTime @default(now())
}

model ManualRevenue {
  id          String   @id @default(uuid())
  description String   @default("")
  amount      Float
  month       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id         String   @id @default(uuid())
  name       String
  percentage Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
