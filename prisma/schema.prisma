generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
  PATIENT
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  patient   Patient?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id             String          @id @default(uuid())
  fullName       String
  cpf            String?         @unique
  phone          String?
  birthDate      String?
  gender         String?
  address        String?
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders         Order[]
  homeCareOrders HomeCareOrder[]
  results        LabResult[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Exam {
  id            String         @id @default(uuid())
  name          String
  code          String?        @unique
  category      String?
  price         Float
  deliveryDays  Int            @default(1)
  description   String?
  orderItems    OrderItem[]
  homeCareItems HomeCareItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Order {
  id         String      @id @default(uuid())
  patientId  String
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  totalPrice Float
  status     String      @default("PENDING")
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  price     Float
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   @default("Operacional")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeCareOrder {
  id             String                  @id @default(uuid())
  patientId      String
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  neighborhood   String
  city           String
  collectionLab  String
  collectionFee  Float                   @default(0)
  travelFee      Float                   @default(0)
  examsTotal     Float                   @default(0)
  totalPrice     Float                   @default(0)
  status         String                  @default("ORCAMENTO")
  items          HomeCareItem[]
  reimbursements HomeCareReimbursement[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model HomeCareItem {
  id              String        @id @default(uuid())
  homeCareOrderId String
  homeCareOrder   HomeCareOrder @relation(fields: [homeCareOrderId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam          @relation(fields: [examId], references: [id])
  price           Float
  createdAt       DateTime      @default(now())
}

model HomeCareReimbursement {
  id              String        @id @default(uuid())
  homeCareOrderId String
  homeCareOrder   HomeCareOrder @relation(fields: [homeCareOrderId], references: [id], onDelete: Cascade)
  description     String
  amount          Float
  status          String        @default("PENDENTE")
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
}

model LabResult {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  fileName  String
  fileSize  Int
  data      Bytes
  createdAt DateTime @default(now())
}